# ==========================================
# Stock-Prediction Environment Configuration
# ==========================================

# Database Configuration (PostgreSQL running in Docker on port 5432)
# Driver: postgresql+psycopg (psycopg v3)
DATABASE_URL=postgresql+psycopg://stockpred:stockpred@localhost:5432/stockpred

# Watchlist tickers (comma-separated)
WATCHLIST=AAPL,MSFT,NVDA

# News API Configuration
NEWSAPI_KEY=your_newsapi_key_here

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Alpaca Paper Trading Credentials
ALPACA_KEY_ID=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading & Risk Controls
RISK_HALT=false
MAX_PREDICTION_AGE_DAYS=3
MAX_PREDICTION_TRADING_DAYS=1

# Backend FastAPI Service
API_HOST=127.0.0.1
API_PORT=8000

# Clerk Authentication Configuration
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Optional Clerk JWKS / Issuer overrides (derived automatically from publishable key if omitted)
# CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
# CLERK_AUDIENCE=stock-prediction-api
# CLERK_PEM_PUBLIC_KEY=

# Clerk Next.js Frontend Redirect Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
